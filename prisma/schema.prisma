generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  // Add connection pooling configuration for MySQL
  relationMode = "prisma"
}

model User {
  id               Int               @id @default(autoincrement())
  email            String?           @unique @db.VarChar(255)
  password         String            @db.VarChar(255)
  name             String?           @db.VarChar(255) // Name for both job seekers and employers
  role             String            @db.VarChar(50)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  contacts         Contact[]
  requestedIn      EmployerRequest[] @relation("RequestedCandidate")
  employerRequests EmployerRequest[] @relation("SelectedUser")
  profile          Profile?
  payments         Payment[]
  paymentApprovals PaymentApproval[]
  // Employer authentication
  employerAccounts EmployerAccount[]
  // Admin profile
  adminProfile     AdminProfile?
  // Audit trail
  auditLogs        AuditLog[]

  // Job seeker availability tracking
  isAvailableForMatching Boolean          @default(true)
  matchedAt              DateTime?
  matchedWithEmployerId  Int?
  matchedEmployerRequest EmployerRequest? @relation("MatchedEmployerRequest", fields: [matchedWithEmployerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Notifications
  notifications           Notification[]
  notificationLogs        NotificationLog[]
  notificationPreferences NotificationPreference[]
}

model Profile {
  id              Int          @id @default(autoincrement())
  userId          Int          @unique
  skills          String?      @db.Text
  photo           String?      @db.VarChar(500)
  gender          String?      @db.VarChar(20)
  experience      String?      @db.VarChar(100)
  jobCategoryId   Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  dateOfBirth     DateTime?
  description     String?      @db.Text
  firstName       String       @db.VarChar(100)
  idNumber        String?      @db.VarChar(20)
  lastName        String       @db.VarChar(100)
  references      String?      @db.Text
  city            String?      @db.VarChar(100)
  contactNumber   String       @db.VarChar(20)
  country         String?      @db.VarChar(100)
  location        String?      @db.VarChar(200)
  maritalStatus   String?      @db.VarChar(20)
  monthlyRate     String?      @db.VarChar(50)
  availability    String?      @db.VarChar(100)
  certifications  String?      @db.Text
  educationLevel  String?      @db.VarChar(100)
  languages       String?      @db.VarChar(200)
  experienceLevel String?      @db.VarChar(100)
  approvalStatus  String       @default("pending") @db.VarChar(20) // pending | approved | rejected
  isActive        Boolean      @default(false)
  approvedAt      DateTime?
  approvedBy      Int?
  rejectionReason String?      @db.Text
  jobCategory     JobCategory? @relation(fields: [jobCategoryId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
}

model EmployerRequest {
  id                   Int               @id @default(autoincrement())
  employerAccountId    Int? // Link to employer account
  message              String?           @db.Text
  selectedUserId       Int?
  createdAt            DateTime          @default(now())
  priority             String            @default("normal") @db.VarChar(20)
  status               String            @default("pending") @db.VarChar(50) // pending | approved | first_payment_required | first_payment_confirmed | photo_access_granted | full_details_requested | second_payment_required | second_payment_confirmed | full_access_granted | hiring_decision_made | hiring_decision_not_made | hired | available | completed | cancelled | process_complete
  updatedAt            DateTime          @updatedAt
  requestedCandidateId Int?
  requestedCandidate   User?             @relation("RequestedCandidate", fields: [requestedCandidateId], references: [id])
  selectedUser         User?             @relation("SelectedUser", fields: [selectedUserId], references: [id])
  employerAccount      EmployerAccount?  @relation(fields: [employerAccountId], references: [id])
  messages             Message[]
  payments             Payment[]
  requestProgress      RequestProgress[]

  // Legacy fields for backward compatibility
  paymentRequired      Boolean   @default(false)
  paymentAmount        Decimal?  @db.Decimal(10, 2)
  paymentCurrency      String?   @default("RWF") @db.VarChar(10)
  paymentDescription   String?   @db.Text
  paymentDueDate       DateTime?
  contactAccessGranted Boolean   @default(false)
  imageAccessGranted   Boolean   @default(false)
  accessGrantedAt      DateTime?
  accessGrantedBy      Int?

  // New workflow fields
  // First payment tracking
  firstPaymentRequired    Boolean   @default(true)
  firstPaymentAmount      Decimal?  @default(5000.00) @db.Decimal(10, 2)
  firstPaymentConfirmed   Boolean   @default(false)
  firstPaymentConfirmedAt DateTime?

  // Second payment tracking
  secondPaymentRequired    Boolean   @default(false)
  secondPaymentAmount      Decimal?  @db.Decimal(10, 2)
  secondPaymentConfirmed   Boolean   @default(false)
  secondPaymentConfirmedAt DateTime?

  // Access control
  partialAccessGranted       Boolean @default(false)
  fullAccessGranted          Boolean @default(false)
  employerVisibleToCandidate Boolean @default(false) // Only true when hired

  // Admin approval tracking
  requestApprovedBy       Int?
  requestApprovedAt       DateTime?
  firstPaymentApprovedBy  Int?
  firstPaymentApprovedAt  DateTime?
  secondPaymentApprovedBy Int?
  secondPaymentApprovedAt DateTime?

  // Hiring decision
  hiringDecision       String?   @db.VarChar(20) // hired | not_hired
  hiringDecisionMadeBy Int?
  hiringDecisionMadeAt DateTime?
  hiringDecisionNotes  String?   @db.Text

  // Completion tracking
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  completedBy Int?

  // Deactivation
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  deactivatedBy Int?

  // Candidate notification
  candidateNotified   Boolean   @default(false)
  candidateNotifiedAt DateTime?

  // Notifications
  notifications    Notification[]
  notificationLogs NotificationLog[]

  // Matched job seekers
  matchedJobSeekers User[] @relation("MatchedEmployerRequest")
}

model Message {
  id                Int             @id @default(autoincrement())
  employerRequestId Int
  fromAdmin         Boolean
  content           String          @db.Text
  createdAt         DateTime        @default(now())
  attachmentName    String?         @db.VarChar(255)
  attachmentUrl     String?         @db.VarChar(500)
  isRead            Boolean         @default(false)
  messageType       String          @default("text") @db.VarChar(20)
  readAt            DateTime?
  updatedAt         DateTime        @updatedAt
  employerRequest   EmployerRequest @relation(fields: [employerRequestId], references: [id])
}

// New model for payment tracking
model Payment {
  id                Int     @id @default(autoincrement())
  employerRequestId Int
  amount            Decimal @db.Decimal(10, 2)
  currency          String  @default("RWF") @db.VarChar(10)
  paymentMethodId   Int // Link to PaymentMethod
  paymentType       String  @db.VarChar(50) // first_installment | second_installment
  paymentReference  String  @db.VarChar(255) // External payment reference
  status            String  @default("pending") @db.VarChar(50) // pending | confirmed | approved | rejected
  description       String? @db.Text

  // Payment confirmation details
  confirmationName  String?   @db.VarChar(255) // Name on the account that made payment
  confirmationPhone String?   @db.VarChar(20) // Phone number that made payment
  confirmationDate  DateTime?
  adminNotes        String?   @db.Text

  // Installment tracking
  installmentNumber Int     @default(1) // 1 for first, 2 for second
  isNonRefundable   Boolean @default(false) // First installment is non-refundable

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  employerRequest EmployerRequest   @relation(fields: [employerRequestId], references: [id])
  paymentMethod   PaymentMethod     @relation(fields: [paymentMethodId], references: [id])
  user            User?             @relation(fields: [userId], references: [id])
  userId          Int?
  approvals       PaymentApproval[]
}

// New model for payment approval workflow
model PaymentApproval {
  id        Int      @id @default(autoincrement())
  paymentId Int
  adminId   Int
  action    String   @db.VarChar(20) // approve | reject
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id])
  admin     User     @relation(fields: [adminId], references: [id])
}

// New model for tracking request progress
model RequestProgress {
  id                Int             @id @default(autoincrement())
  employerRequestId Int
  stage             String          @db.VarChar(50) // request_received | approved | first_payment_required | first_payment_confirmed | photo_access_granted | full_details_requested | second_payment_required | second_payment_confirmed | full_access_granted | hiring_decision_made | completed
  status            String          @db.VarChar(20) // pending | in_progress | completed | failed
  description       String          @db.Text
  adminNotes        String?         @db.Text
  completedAt       DateTime?
  completedBy       Int?
  createdAt         DateTime        @default(now())
  employerRequest   EmployerRequest @relation(fields: [employerRequestId], references: [id])
}

model Contact {
  id                   Int       @id @default(autoincrement())
  name                 String    @db.VarChar(255)
  email                String    @db.VarChar(255)
  subject              String    @db.VarChar(255)
  message              String    @db.Text
  status               String    @default("unread") @db.VarChar(20)
  priority             String    @default("normal") @db.VarChar(20)
  category             String    @default("general") @db.VarChar(50)
  adminResponse        String?   @db.Text
  adminResponseSubject String?   @db.VarChar(255)
  respondedBy          Int?
  respondedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  admin                User?     @relation(fields: [respondedBy], references: [id])
}

model JobCategory {
  id        Int       @id @default(autoincrement())
  name_en   String    @db.VarChar(255)
  name_rw   String    @db.VarChar(255)
  createdAt DateTime  @default(now())
  profiles  Profile[]
}

// Audit log for tracking all actions
model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String   @db.VarChar(100) // e.g., payment_confirmed, payment_approved, access_granted
  entityType String   @db.VarChar(50) // e.g., payment, employer_request, user
  entityId   Int // ID of the related entity
  userId     Int? // User who performed the action
  userRole   String   @db.VarChar(50) // e.g., admin, employer, jobseeker
  details    Json? // Additional action details
  ipAddress  String?  @db.VarChar(45) // IP address of the user
  userAgent  String?  @db.Text // User agent string
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
}

// Dynamic payment methods management
model PaymentMethod {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(100) // e.g., "MTN MOMO", "Airtel Money"
  type          String    @db.VarChar(50) // e.g., "mobile_money", "bank_transfer"
  accountName   String    @db.VarChar(255) // Account holder name
  accountNumber String    @db.VarChar(100) // Phone number or account number
  bankName      String?   @db.VarChar(100) // For bank transfers
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payments      Payment[]
}

// Employer account model for authentication
model EmployerAccount {
  id               Int               @id @default(autoincrement())
  userId           Int               @unique
  phoneNumber      String?           @db.VarChar(20)
  companyName      String?           @db.VarChar(255)
  isActive         Boolean           @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id])
  employerRequests EmployerRequest[]
}

// Admin profile model for dynamic profile management
model AdminProfile {
  id             Int  @id @default(autoincrement())
  adminId        Int  @unique
  personal       Json // Personal information (name, title, location, etc.)
  skills         Json // Skills organized by category
  experience     Json // Professional experience array
  education      Json // Education history array
  certifications Json // Professional certifications array
  projects       Json // Portfolio projects array

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  admin     User     @relation(fields: [adminId], references: [id])
}

// Notification system for tracking all notifications
model Notification {
  id                Int              @id @default(autoincrement())
  userId            Int
  employerRequestId Int?
  type              String           @db.VarChar(50) // request_received | request_approved | payment_request | payment_confirmed | access_granted | completion | full_details_requested | hired | custom
  title             String           @db.VarChar(255)
  message           String           @db.Text
  isRead            Boolean          @default(false)
  readAt            DateTime?
  createdAt         DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id])
  employerRequest   EmployerRequest? @relation(fields: [employerRequestId], references: [id])
}

model NotificationLog {
  id                Int              @id @default(autoincrement())
  userId            Int
  employerRequestId Int?
  type              String           @db.VarChar(50) // request_received | request_approved | hired | etc.
  sentAt            DateTime         @default(now())
  via               String           @db.VarChar(20) // email | inapp | sms
  user              User             @relation(fields: [userId], references: [id])
  employerRequest   EmployerRequest? @relation(fields: [employerRequestId], references: [id])
}

model NotificationPreference {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   @db.VarChar(50) // request_received | request_approved | hired | etc.
  optedOut  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}
